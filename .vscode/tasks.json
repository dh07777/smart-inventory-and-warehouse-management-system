{
  "version": "2.0.0",
  "tasks": [
    { "label": "Backend: run API", "type": "shell", "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe wsgi.py",
      "options": { "cwd": "${workspaceFolder}/backend" }, "isBackground": true, "problemMatcher": [], "presentation": { "panel": "dedicated", "group": "stockpilot" } },
    { "label": "Frontend: run dev server", "type": "shell", "command": "npm run dev",
      "options": { "cwd": "${workspaceFolder}/frontend" }, "isBackground": true, "problemMatcher": [], "presentation": { "panel": "dedicated", "group": "stockpilot" } },
    { "label": "Run StockPilot (API + web)", "dependsOn": ["Backend: run API", "Frontend: run dev server"], "problemMatcher": [] },
    { "label": "Backend: tests", "type": "shell", "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe -m pytest -v",
      "options": { "cwd": "${workspaceFolder}/backend" }, "problemMatcher": [] },
    { "label": "Frontend: tests", "type": "shell", "command": "npm test", "options": { "cwd": "${workspaceFolder}/frontend" }, "problemMatcher": [] },
    { "label": "Seed demo data (reset)", "type": "shell", "command": "${workspaceFolder}\\backend\\.venv\\Scripts\\python.exe seed.py --reset",
      "options": { "cwd": "${workspaceFolder}/backend" }, "problemMatcher": [] }
  ]
}
