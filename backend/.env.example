# Copy to .env (or run: python scripts/make_env.py) and NEVER commit .env
APP_ENV=development
SECRET_KEY=
JWT_SECRET_KEY=
DATABASE_URL=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
RATELIMIT_STORAGE_URI=memory://
FRONTEND_URL=http://localhost:5173
# Optional SMTP for password-reset e-mails (leave empty to log the reset link in the console)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@stockpilot.local
